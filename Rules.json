  "rules": [
    {
      "id": "IDENT-001",
      "description": "Disabled account remains in one or more privileged groups",
      "category": "Identity",
      "severity": "Critical",
      "weight": 100,
      "blocking": true,
      "type": "Evaluate-PrivilegeDrift",
      "parameters": {
        "requireEnabled": true,
        "scope": "PrivilegedGroups"
      },
      "suppressesOnMatch": []
    },
    {
      "id": "IDENT-002",
      "description": "Account has no UPN or malformed UPN",
      "category": "Identity",
      "severity": "High",
      "weight": 70,
      "blocking": true,
      "type": "Evaluate-EmploymentAlignment",
      "parameters": {
        "field": "UserPrincipalName",
        "validationPattern": "^[^@]+@[^@]+\\.[^@]+$"
      },
      "suppressesOnMatch": []
    },
    {
      "id": "IDENT-003",
      "description": "Account employment status is not Active or is unresolvable — covers missing HR record and Unknown status",
      "category": "Identity",
      "severity": "Medium",
      "weight": 40,
      "blocking": false,
      "type": "Evaluate-EmploymentAlignment",
      "parameters": {
        "field": "EmploymentStatus",
        "requiredValue": "Active",
        "unknownTrigger": true,
        "emitReason": true
      },
      "suppressesOnMatch": [],
      "supersededBy": ""
    },
    {
      "id": "ACCESS-001",
      "description": "Intern or temporary worker assigned to a Manager-level privileged group",
      "category": "Access",
      "severity": "High",
      "weight": 80,
      "blocking": true,
      "type": "Evaluate-EmploymentAlignment",
      "parameters": {
        "jobTitlePatterns": ["Intern","Trainee","Temporary","Contractor"],
        "forbiddenGroupPatterns": ["Manager","Admin","Privileged","Tier0","Tier1"]
      },
      "supersededBy": "ENT-002",
      "suppressesOnMatch": []
    },
    {
      "id": "ACCESS-002",
      "description": "Terminated or offboarded account retains active group memberships",
      "category": "Access",
      "severity": "Critical",
      "weight": 100,
      "blocking": true,
      "type": "Evaluate-EmploymentAlignment",
      "parameters": {
        "terminatedStatuses": ["Terminated","Offboarded","Left","Resigned"],
        "scope": "AllGroups"
      },
      "suppressesOnMatch": []
    },
    {
      "id": "ACCESS-003",
      "description": "Account is in both privileged and standard groups simultaneously",
      "category": "Access",
      "severity": "High",
      "weight": 75,
      "blocking": false,
      "type": "Evaluate-PrivilegeDrift",
      "parameters": {
        "detectMixedMembership": true
      },
      "suppressesOnMatch": []
    },
    {
      "id": "ENT-001",
      "description": "Employment type not permitted for assigned group — flagged for review",
      "category": "Access",
      "severity": "High",
      "weight": 70,
      "blocking": false,
      "type": "Evaluate-EntitlementModel",
      "parameters": {
        "checkEmployment": true,
        "checkPrivilegedTier": false
      },
      "suppressesOnMatch": []
    },
    {
      "id": "ENT-002",
      "description": "Employment type not permitted for a privileged-tier group — block provisioning",
      "category": "Access",
      "severity": "Critical",
      "weight": 100,
      "blocking": true,
      "type": "Evaluate-EntitlementModel",
      "parameters": {
        "checkEmployment": false,
        "checkPrivilegedTier": true
      },
      "suppressesOnMatch": ["ACCESS-001"]
    },
    {
      "id": "ENT-003",
      "description": "User is in a group not defined in the entitlement model",
      "category": "Access",
      "severity": "Low",
      "weight": 15,
      "blocking": false,
      "type": "Evaluate-EntitlementModel",
      "parameters": {
        "checkEmployment": false,
        "checkPrivilegedTier": false,
        "unknownGroupAlert": true
      },
      "_note": "Downgraded from High/50 to Low/15. Unmanaged group is a coverage gap, not a compliance failure.",
      "suppressesOnMatch": []
    },
    {
    "id": "ENT-004",
    "description": "Contractor or Intern cannot be provisioned into a Manager-tier role",
    "category": "Access",
    "severity": "Critical",
    "weight": 100,
    "blocking": true,
    "type": "Evaluate-PayloadEntitlementPolicy",
    "parameters": {
    "restrictedEmploymentTypes": ["Contractor", "Intern"],
    "restrictedJobTitlePatterns": ["Manager", "Director", "Head", "HOD", "Executive"]
  },
   "suppressesOnMatch": []
  },
  {
  "id": "PIM-001",
  "description": "PIM group eligibility schedules present post-provision",
  "category": "Access",
  "severity": "Low",
  "weight": 15,
  "blocking": false,
  "type": "Evaluate-PimEligibility",
  "parameters": {},
  "suppressesOnMatch": [],
  "_note": "Informational — confirms PIM eligibility was assigned. Non-blocking because PIM schedule propagation can lag 15-30 seconds after assignment."
},
    {
      "id": "JOIN-001",
      "description": "Joiner: employment record not found — block provisioning",
      "category": "Identity",
      "severity": "Critical",
      "weight": 100,
      "blocking": true,
      "type": "Evaluate-EmploymentAlignment",
      "parameters": {
        "joinerCheck": true,
        "field": "EmploymentStatus",
        "requiredValue": "Active",
        "joinerWindowDays": 30
      },
      "suppressesOnMatch": []
    },
    {
      "id": "JOIN-002",
      "description": "Joiner: job title maps to restricted privileged group — block provisioning",
      "category": "Access",
      "severity": "High",
      "weight": 80,
      "blocking": true,
      "type": "Evaluate-EmploymentAlignment",
      "parameters": {
        "joinerCheck": true,
        "jobTitlePatterns": ["Intern","Trainee","Temporary"],
        "forbiddenGroupPatterns": ["Manager","Admin","Privileged","Tier0","Tier1"],
        "joinerWindowDays": 30
      },
      "suppressesOnMatch": []
    },
    {
      "id": "ARCH-001",
      "description": "Tier 0 asset managed by a non-Tier 0 account",
      "category": "Architecture",
      "severity": "Critical",
      "weight": 100,
      "blocking": true,
      "type": "Evaluate-PrivilegeDrift",
      "parameters": {
        "tier0GroupPatterns": ["Tier0","DomainAdmins","EnterpriseAdmins","PrivilegedAccessWorkstation"],
        "enforceTierIsolation": true
      },
      "suppressesOnMatch": []
    },
    {
      "id": "ARCH-002",
      "description": "Admin account used for day-to-day operations — no account separation",
      "category": "Architecture",
      "severity": "High",
      "weight": 70,
      "blocking": false,
      "type": "Evaluate-PrivilegeDrift",
      "parameters": {
        "detectAdminAccountDualUse": true,
        "adminAccountPatterns": ["adm_","admin.","_admin","svc_"]
      },
      "suppressesOnMatch": []
    },
    {
      "id": "ARCH-003",
      "description": "Service account is in interactive user groups",
      "category": "Architecture",
      "severity": "High",
      "weight": 65,
      "blocking": false,
      "type": "Evaluate-PrivilegeDrift",
      "parameters": {
        "serviceAccountPatterns": ["svc_","_svc","service.",".svc"],
        "forbiddenGroupPatterns": ["AllUsers","Staff","Employees","InteractiveUsers"]
      },
      "suppressesOnMatch": []
    },
    {
      "id": "HYG-001",
      "description": "Account has not signed in for more than 90 days",
      "category": "Hygiene",
      "severity": "Medium",
      "weight": 35,
      "blocking": false,
      "type": "Evaluate-EmploymentAlignment",
      "parameters": {
        "field": "LastSignInDateTime",
        "maxInactiveDays": 90
      },
      "supersededBy": "HYG-002",
      "suppressesOnMatch": []
    },
    {
      "id": "HYG-002",
      "description": "Account has not signed in for more than 180 days — stale",
      "category": "Hygiene",
      "severity": "High",
      "weight": 65,
      "blocking": false,
      "type": "Evaluate-EmploymentAlignment",
      "parameters": {
        "field": "LastSignInDateTime",
        "maxInactiveDays": 180
      },
      "_dataNote": "Requires AuditLog.Read.All scope. Without it, LastSignInDateTime is null for all users and this rule fires tenant-wide.",
      "suppressesOnMatch": ["HYG-001"]
    },
    {
      "id": "HYG-003",
      "description": "Account password has not been changed in over 365 days",
      "category": "Hygiene",
      "severity": "Medium",
      "weight": 40,
      "blocking": false,
      "type": "Evaluate-EmploymentAlignment",
      "parameters": {
        "field": "LastPasswordChangeDateTime",
        "maxAgeDays": 365
      },
      "suppressesOnMatch": []
    },
    {
      "id": "HYG-004",
      "description": "Privileged account has no MFA registered or enforced",
      "category": "Hygiene",
      "severity": "Critical",
      "weight": 100,
      "blocking": true,
      "type": "Evaluate-PrivilegeDrift",
      "parameters": {
        "requireMFA": true,
        "scope": "PrivilegedGroups"
      },
      "suppressesOnMatch": []
    },
    {
      "id": "RBAC-001",
      "description": "Direct Azure role assignment detected — must be group-based",
      "category": "RBAC",
      "severity": "High",
      "weight": 80,
      "blocking": false,
      "type": "Evaluate-DirectRoleAssignments",
      "parameters": {
        "allowedAssignmentTypes": ["Group"]
      },
      "supersededBy": "RBAC-003",
      "suppressesOnMatch": []
    },
    {
      "id": "RBAC-002",
      "description": "Privileged role assigned at subscription scope — must be resource-group or below",
      "category": "RBAC",
      "severity": "High",
      "weight": 75,
      "blocking": false,
      "type": "Evaluate-DirectRoleAssignments",
      "parameters": {
        "forbiddenScopes": ["/subscriptions/"],
        "privilegedRoles": ["Owner","Contributor","User Access Administrator"]
      },
      "supersededBy": "RBAC-003",
      "_note": "Suppressed by RBAC-003 when a forbidden role is also present for the same entity.",
      "suppressesOnMatch": []
    },
    {
      "id": "RBAC-003",
      "description": "Owner role assigned directly to a user at any scope",
      "category": "RBAC",
      "severity": "Critical",
      "weight": 100,
      "blocking": true,
      "type": "Evaluate-DirectRoleAssignments",
      "parameters": {
        "forbiddenRoles": ["Owner"],
        "assignmentType": "User"
      },
      "suppressesOnMatch": ["RBAC-002","RBAC-001"],
      "_note": "Primary rule for Owner assignment. Suppresses RBAC-002 and RBAC-001 when all three would fire for same entity."
    },
    {
      "id": "CORR-001",
      "description": "Privileged-tier group member holds Owner or UAA role at subscription scope",
      "category": "Correlation",
      "severity": "Critical",
      "weight": 100,
      "blocking": true,
      "type": "Evaluate-CrossPlaneExposure",
      "parameters": {
        "requirePrivilegedTier": true,
        "forbiddenRoles": ["Owner","User Access Administrator"],
        "forbiddenScopes": ["/subscriptions/"]
      },
      "suppressesOnMatch": ["CORR-004"]
    },
    {
      "id": "CORR-002",
      "description": "Disabled account retains active Azure RBAC role assignments",
      "category": "Correlation",
      "severity": "Critical",
      "weight": 100,
